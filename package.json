{
  "name": "token-launch-bot",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "compile": "tsx scripts/compile.ts",
    "dev": "npm run compile && tsx watch src/app/main.ts",
    "start": "npm run compile && tsx src/app/main.ts",
    "build": "npm run compile && tsc",
    "start:prod": "node dist/app/main.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test $(find src -name '*.test.ts')",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "dotenv": "^16.4.0",
    "viem": "^2.57.7"
  },
  "devDependencies": {
    "@openzeppelin/contracts": "5.6.1",
    "@types/node": "^22.0.0",
    "prettier": "^3.5.0",
    "solc": "0.8.30",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
