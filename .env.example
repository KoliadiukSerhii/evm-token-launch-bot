# --- Launch ------------------------------------------------------------------
# Chains to launch on and monitor, comma-separated. Available: ethereum, base, bnb
CHAINS=base
# Tokens, comma-separated, each "Name:SYMBOL" or "Name:SYMBOL:supply" (default supply 1000000000).
# One live token per chain. The same list is the deploy queue on every chain.
# The next symbol deploys only after the previous one on that chain has fully exited, plus 5 minutes.
TOKENS="My Brand:BRAND"
# Native side of the pool in USD (whole number): ETH on ethereum/base, BNB on bnb.
POOL_USD=500
# Auto-remove pool liquidity after this duration (s/m/h/d). Default 24h if omitted.
POOL_LIFETIME=24h

# --- Wallet ------------------------------------------------------------------
# Deployer key, same address on every chain. Receives the LP tokens.
PRIVATE_KEY=

# --- RPC ---------------------------------------------------------------------
# Comma-separated, https:// and wss:// mixed. Reads go through them in order with
# fallback, transactions are broadcast to all of them at once. A wss:// endpoint
# pushes new blocks instead of polling for them.
ETHEREUM_RPC_URLS=
BASE_RPC_URLS=
BNB_RPC_URLS=

# --- Withdraw (pool shutdown) ------------------------------------------------
# Optional private/protected RPC for remove-liquidity txs only (not launch/monitor).
# Comma-separated https:// endpoints per chain, e.g. Flashbots Protect on ethereum.
# If empty, withdraw uses the public *_RPC_URLS above with urgent gas fees.
ETHEREUM_WITHDRAW_RPC_URLS=
BASE_WITHDRAW_RPC_URLS=
BNB_WITHDRAW_RPC_URLS=

# --- Telegram ----------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
